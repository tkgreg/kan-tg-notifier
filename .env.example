# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# PostgreSQL connection string
DATABASE_URL=postgres://kan_tg_notifier:kan_tg_notifier@localhost:5432/kan_tg_notifier

# Shared secret configured on the Kan.bn workspace webhook.
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET=change-me-to-a-long-random-string

# Base URL of your Kan.bn instance, used for deep links in notifications
KAN_BASE_URL=https://kan.example.com

# HTTP server bind address for the webhook receiver
HOST=0.0.0.0
PORT=8080

# Comma-separated Telegram user IDs allowed to approve /link requests
# and manage user mappings (get yours from @userinfobot)
ADMIN_TELEGRAM_IDS=

# Approve /link requests automatically without admin review (true/false).
# Leave false unless you trust everyone who can talk to the bot.
AUTO_APPROVE_LINKS=false

# Reject webhook payloads whose signed timestamp is older than this many
# seconds (replay protection). 0 disables the check.
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=600

# pino log level: trace, debug, info, warn, error, fatal
LOG_LEVEL=info
