# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# PostgreSQL connection string
DATABASE_URL=postgres://kan_tg_notifier:kan_tg_notifier@localhost:5432/kan_tg_notifier

# Shared secret configured on the Kan.bn workspace webhook.
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET=change-me-to-a-long-random-string

# Base URL of your Kan.bn instance, used for deep links in notifications
KAN_BASE_URL=https://kan.example.com

# HTTP server bind address for the webhook receiver
HOST=0.0.0.0
PORT=8080

# persistent: long-lived process. The bot uses long polling, webhook
# deliveries are acknowledged immediately and processed on a background
# queue, and timers prune the event log. Use this for Docker/VMs.
# serverless: for platforms that stop or freeze the container between
# requests (e.g. Cloud Run scaled to zero). The bot receives updates over
# HTTPS and notifications are delivered before the webhook is acknowledged.
RUNTIME_MODE=persistent

# Public HTTPS base URL of this service. Required for RUNTIME_MODE=serverless
# and by `npm run telegram:webhook`, which registers the Telegram webhook.
# PUBLIC_URL=https://kan-bot.example.com

# Secret token Telegram must echo back on every update delivery
# (16-256 chars, A-Z a-z 0-9 _ -). Derived from the bot token when unset.
# TELEGRAM_WEBHOOK_SECRET=

# Apply pending database migrations on startup. Set to false where cold
# start latency matters and migrations are applied out of band instead.
RUN_MIGRATIONS=true

# Comma-separated Telegram user IDs allowed to approve /link requests
# and manage user mappings (get yours from @userinfobot)
ADMIN_TELEGRAM_IDS=

# Approve /link requests automatically without admin review (true/false).
# Leave false unless you trust everyone who can talk to the bot.
AUTO_APPROVE_LINKS=false

# In group notifications, mention the affected member's linked Telegram
# account (@username or profile link) instead of their Kan (OIDC) name.
GROUP_MEMBER_MENTIONS=true

# Reject webhook payloads whose signed timestamp deviates more than this
# many seconds from server time (replay protection). 0 disables the check.
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=600

# Delete event log entries older than this many days. 0 keeps them forever.
EVENT_LOG_RETENTION_DAYS=30

# pino log level: trace, debug, info, warn, error, fatal
LOG_LEVEL=info
