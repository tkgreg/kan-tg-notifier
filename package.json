{
  "name": "kan-tg-notifier",
  "version": "1.1.0",
  "description": "Telegram bot that notifies users and groups about changes in Kan.bn via webhooks, with OIDC user to Telegram account mapping",
  "license": "AGPL-3.0",
  "type": "module",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\" \"*.md\" \"features/**/*.md\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "telegram:webhook": "tsx --env-file=.env src/cli/telegram-webhook.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.2",
    "fastify": "^5.4.0",
    "grammy": "^1.36.3",
    "pg": "^8.16.3",
    "pino": "^9.7.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.4",
    "@eslint/js": "^9.30.0",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.4",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.30.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.0",
    "vitest": "^3.2.4"
  }
}
